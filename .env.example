# Copy to `.env` and fill in. Optional variables can be omitted.

# --- Telegram bot (tg_notify.py mirrors chat to a group/topic; tg_update.py polls inbound)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
# Forum topic / thread id (leave empty if not using topics)
TELEGRAM_NOTIFY_MESSAGE_THREAD_ID=

# --- Telegram MTProto for tg_news.py (get api_id / api_hash from https://my.telegram.org)
TG_NEWS_API_ID=
TG_NEWS_API_HASH=

# --- Optional: TUI keyboard debug (chat_tui)
# SISH_KBD_DEBUG=1

# --- Optional: override keychain-stored password (see chat_common/session.py)
# CHAT_DNSTT_PASSWORD_<NORMALIZED_HOST_OR_DOMAIN_AND_USER>=

# --- Codex / ChatGPT integration
# Telegram user to notify for Codex auth (default: @Meton_exir)
CODEX_TELEGRAM_NOTIFY_USER=@Meton_exir
# Working directory for Codex on the server (default: ~/codex_dir)
# CODEX_WORK_DIR=~/codex_dir
